{"openapi":"3.0.0","paths":{"/api/private/events":{"post":{"description":"Creates an event in the database and sends it to Klaviyo. The event is saved locally regardless of Klaviyo API status.","operationId":"eventcontroller-create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateEventDto"},"examples":{"Active on Site":{"summary":"Example: Customer active on site","value":{"eventName":"Active on Site","eventAttributes":{"page":"/home","source":"web"},"profileAttributes":{"email":"customer@example.com","first_name":"John","last_name":"Doe","phone_number":"+1234567890"}}},"Viewed Product":{"summary":"Example: Customer viewed a product","value":{"eventName":"Viewed Product","eventAttributes":{"productId":"PROD-789","productName":"Laptop","price":1299.99},"profileAttributes":{"email":"customer@example.com","first_name":"John"}}}}}}},"responses":{"201":{"description":"Event created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventResponseDto"},"examples":{"success":{"summary":"Event created successfully","value":{"success":true,"message":"Event created successfully","data":{"id":1,"eventName":"Active on Site","createdAt":"2024-11-17T10:30:00.000Z"}}}}}}},"400":{"description":"Bad Request - Invalid input data"}},"summary":"Create a single event","tags":["Events"]}},"/api/private/events/bulk":{"post":{"description":"Creates multiple events in the database and sends them to Klaviyo in a single batch. All events are saved locally regardless of Klaviyo API status.","operationId":"eventcontroller-createbulk","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateBulkEventsDto"},"examples":{"Multiple Events":{"summary":"Example: Create multiple events at once","value":{"events":[{"eventName":"Active on Site","eventAttributes":{"page":"/home","source":"web"},"profileAttributes":{"email":"customer1@example.com","first_name":"John","last_name":"Doe"}},{"eventName":"Viewed Product","eventAttributes":{"productId":"PROD-123","productName":"Laptop","price":1299.99},"profileAttributes":{"email":"customer2@example.com","first_name":"Jane","last_name":"Smith"}}]}}}}}},"responses":{"201":{"description":"Bulk events created successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkEventResponseDto"},"examples":{"success":{"summary":"Bulk events created successfully","value":{"success":true,"message":"Bulk events created successfully","data":{"created":2,"failed":0,"details":[{"id":1,"eventName":"Active on Site","createdAt":"2024-11-17T10:30:00.000Z"},{"id":2,"eventName":"Viewed Product","createdAt":"2024-11-17T10:30:05.000Z"}]}}}}}}},"400":{"description":"Bad Request - Invalid input data"}},"summary":"Create multiple events in bulk","tags":["Events"]}},"/api/private/metrics":{"get":{"description":"Retrieves all available metrics from Klaviyo with pagination and search support","operationId":"metriccontroller-getallmetrics","parameters":[{"name":"page","required":false,"in":"query","description":"Page number for pagination","schema":{"default":1,"type":"number"}},{"name":"limit","required":false,"in":"query","description":"Number of items per page (max: 100)","schema":{"default":10,"type":"number"}},{"name":"search","required":false,"in":"query","description":"Search term for global search across event names, profile emails, and metric names","schema":{"type":"string"}},{"name":"filters","required":false,"in":"query","description":"Filters in JSON format. Available types: includesString, greaterOrEqual, lessOrEqual, equals, notEquals, arrIncludes, isDateBetween, equalDateYear. Use for filtering events by metric, profiles by email, or date ranges.","schema":{"type":"string"}},{"name":"orders","required":false,"in":"query","description":"Sorting orders in JSON format. Direction can be ASC or DESC. Common columns: createdAt, eventName, email","s